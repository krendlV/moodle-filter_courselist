<link rel="stylesheet" type="text/css" href="{{ wwwroot }}/filter/courselist/lib/slick/slick.css"/>
<link rel="stylesheet" type="text/css" href="{{ wwwroot }}/filter/courselist/lib/slick/slick-theme.css"/>

<style>
.slick-carousel.responsive .slick-carousel-container {
    margin: 0 30px;
    height: 1000px;
}
.slick-carousel.responsive .slick-prev {        
    width: 40px;
    height: 40px;
    z-index: 99999;
    left: -30px;
}
.slick-carousel.responsive .slick-next {        
    width: 40px;
    height: 40px;    
    z-index: 99999;
    right: -30px;
}
.slick-carousel.responsive .slick-prev:before, .slick-carousel.responsive .slick-next:before {
    color: var(--primary);
    font-size: 40px;
}
.slick-carousel.responsive .slick-slide {    
    padding: 16px;
}
</style>


<div id=carousel-container-{{uniqid}} class="slick-carousel-container">
    <div id=carousel-{{uniqid}} class="slick-carousel responsive card-deck">

        {{#courses}}
        <div>
            <div class="card dashboard-card course-{{{id}}}{{{categories}}} w-100" role="listitem"
                data-region="course-content"
                data-course-id="{{{id}}}">
                <div class="tm-moove-category course-category">
                    <a href="/course/index.php?categoryid={{category}}">{{coursecategory}}</a>
                </div>
                <a href="{{wwwroot}}/course/view.php?id={{id}}" tabindex="-1">
                    <div class="card-img dashboard-card-img{{defaultimgclass}}" style='background-image: url("{{{courseimage}}}");'>                
                        <span class="sr-only">{{#str}}aria:courseimage, core_course{{/str}}</span>
                    </div>
                </a>
                <div class="card-body pr-1 course-info-container" id="course-info-container-{{id}}-{{uniqid}}">
                    <div class="d-flex align-items-start">
                        <div class="w-100">
                            {{#showshortname}}
                                <div class="text-muted muted d-flex mb-1 flex-wrap">
                                    <span class="sr-only">
                                        {{#str}}aria:courseshortname, core_course{{/str}}
                                    </span>
                                    <div>
                                        {{{shortname}}}
                                    </div>
                                    {{$divider}}{{/divider}}
                                </div>
                            {{/showshortname}}
                            <a href="{{wwwroot}}/course/view.php?id={{id}}" class="aalink coursename mr-2 mb-1">
                                {{> core_course/favouriteicon }}
                                <span class="sr-only">
                                        {{#str}}aria:coursename, core_course{{/str}}
                                    </span>
                                {{fullname}}
                            </a>
                            <div class="course-summary">
                                {{{summary}}}
                            </div>
                            {{^visible}}
                                <div class="d-flex flex-wrap">
                                    <span class="badge badge-info">{{#str}} hiddenfromstudents {{/str}}</span>
                                </div>
                            {{/visible}}
                        </div>
                    </div>
                </div>
                {{#courseprogress}}
                <div class="card-footer dashboard-card-footer border-0 bg-white w-100">
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" aria-valuenow="{{progress}}" style="width: {{progress}}%" aria-valuemin="0" aria-valuemax="{{progress}}"></div>
                    </div>
                    <p class="mb-0">{{courseprogress}}% complete</p>
                </div>
                {{/courseprogress}}
            </div>
        </div>
        {{/courses}}

    </div>
</div>
				
{{#js}}    
    require(['filter_courselist/slick_carousel'], (module) => module.init());
    require(['filter_courselist/resize_cards'], (module) => module.init());
{{/js}}

<script>

function adjustCarouselDimensions() {    

    let slideshows = document.getElementsByClassName("slick-carousel")    

    for (let j = 0; j < slideshows.length; j++) {

        // Fix height for cards.
        let cards = slideshows[j].getElementsByClassName('card')    
        let height = 0    
        
        if (cards) {    
            
            // Get max height.
            for (let i = 0; i < cards.length; i++) {  
                if (cards[i].offsetHeight > height) {                
                    cards[i].style.minHeight = 0;                
                    height = cards[i].offsetHeight
                }  
            }
            
            // Set min height.        
            heightPx = height + 'px'        
            for (let i = 0; i < cards.length; i++) {  
                cards[i].style.minHeight = heightPx;                
            }
        }   

        // Fix carousel width inside text labels.
        let pageWidth = document.getElementById("page-content").offsetWidth
        pageWidth = pageWidth - 60
        pageWidth = pageWidth + "px"
        slideshows[j].style.width = pageWidth       

        // Fix carousel height inside text labels.
        // let totalHeight = slideshows[j].offsetHeight + 30
        let totalHeight = height + 60
        totalHeightPx = totalHeight + "px"                
        slideshows[j].parentElement.style.height = totalHeightPx 

    }
}

if (typeof slickResizeObserver === 'undefined') {

    const slickResizeObserver = new ResizeObserver(entries => {

        console.log('Adjusting card height and total width for slick carousel')

        adjustCarouselDimensions()

    });

    slickResizeObserver.observe(document.getElementById("page-content"));

}


</script>
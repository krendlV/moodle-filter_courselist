{{#courses}}

    <ion-card>

        <a href="/course/view.php?id={{id}}" style="height: 100%; width: 100%; position: absolute; top: 0; left: 0; z-index: 1;"></a>

        <ion-card-header style="padding: 0;">

            <img src="{{courseimage}}" style="margin: 0; width: 100%; height: 100px; object-fit: cover; border-radius: 0;" alt="{{fullname}}"><img>

            <ion-card-title style="margin-top: -1em; padding: 0 0.75em 0.25em 0.75em;">
                {{fullname}}
            </ion-card-title>

        </ion-card-header>

        <ion-card-content>

            {{^visible}}
                <ion-text>
                    {{#str}} hiddenfromstudents {{/str}}
                </ion-text>
            {{/visible}}

            <div>
                <strong>
                   {{coursecategory}}
                </strong>
            </div>

            {{#courseprogress}}

                 <div style="position: relative; width: 100%; height: 20px; border: 1px solid lightgrey; margin-top: 0.5em;">
                    <div style="width: 100%; position: absolute; top: 0; left: 0; text-align: center; line-height: 1.4; z-index: 10;">{{courseprogress}}% complete</div>
                    <div style="width: {{courseprogress}}%; height: 100%; background-color: #81ae3b; position: absolute; left: 0; top: 0;"></div>
                </div>

            {{/courseprogress}}

        </ion-card-content>

    </ion-card>

{{/courses}}

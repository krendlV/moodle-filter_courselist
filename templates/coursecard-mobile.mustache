{{#courses}}

    <ion-card style="position: relative; overflow: hidden;">

        <a href="/course/view.php?id={{id}}" style="height: 100%; width: 100%; position: absolute; top: 0; left: 0; z-index: 1;"></a>

        <ion-card-header style="padding: 0; position: relative;">

            <img src="{{courseimage}}" style="width: 100%; height: 100px; object-fit: cover; border-radius: 0;" alt="{{fullname}}">

        </ion-card-header>

        <!-- Full name under the image -->
        <ion-card-title style="padding: 0.75em; font-weight: bold;">
            {{fullname}}
        </ion-card-title>

        <ion-card-content style="padding: 0.75em;">

            {{^visible}}
                <ion-text style="display: block;">
                    {{#str}} hiddenfromstudents {{/str}}
                </ion-text>
            {{/visible}}

            <ion-text style="font-weight: bold; display: block;">
                {{coursecategory}}
            </ion-text>

            {{#courseprogress}}

                <div style="position: relative; width: 100%; height: 20px; border: 1px solid lightgrey; margin-top: 0.5em;">
                    <div style="width: 100%; position: absolute; top: 0; left: 0; text-align: center; line-height: 1.4; z-index: 10;">{{courseprogress}}% complete</div>
                    <div style="width: {{courseprogress}}%; height: 100%; background-color: #81ae3b; position: absolute; left: 0; top: 0;"></div>
                </div>

            {{/courseprogress}}

        </ion-card-content>

    </ion-card>

{{/courses}}
